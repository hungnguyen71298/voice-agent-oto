# Required — STT and LLM both route through this one key
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — without it, search_internet returns mock results
TAVILY_API_KEY=

# Optional — swap models and engines without touching code
# STT_MODEL=openai/whisper-large-v3
# LLM_MODEL=google/gemini-3.5-flash-lite

# TTS runs locally by default: no key, no network, no rate limit.
# TTS_ENGINE=piper                      # piper | edge
# PIPER_VOICE=vi_VN-vais1000-medium     # or vi_VN-25hours_single-low
# PIPER_CUDA=0                          # needs onnxruntime-gpu; CPU is already ~93ms

# TTS_ENGINE=edge trades ~350ms of latency for a noticeably better voice.
# Microsoft throttles it under back-to-back load — fine for driving, not for benchmarks.
# EDGE_VOICE=vi-VN-HoaiMyNeural         # or vi-VN-NamMinhNeural (male)
# EDGE_RATE=+0%

# Demo dashboard at http://127.0.0.1:8080. UI_PORT=0 turns it off entirely.
# UI_PORT=8080
# UI_HOST=127.0.0.1                     # Docker needs 0.0.0.0 to be reachable

# Microphone. Leave unset to use the system default — but on Windows the default is
# often an MME device that opens fine and then delivers pure silence. Run
# `python scripts/mic.py` to find an index that actually hears you.
# INPUT_DEVICE=6
# INPUT_RATE=44100                      # capture at the device's native rate; see docs/cai-dat.md

# Trần chi phí LLM mỗi phiên — chốt chặn vòng lặp kẹt, không phải quota người dùng.
# Đặt 0 để tắt giới hạn đó.
# MAX_TURNS=200
# MAX_TOKENS=500000

# KB_TOP_K=3
