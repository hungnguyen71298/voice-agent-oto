# Required — one key for STT, LLM and TTS alike
OPENROUTER_API_KEY=sk-or-v1-...

# Optional — without it, search_internet returns mock results
TAVILY_API_KEY=

# Optional — swap models without touching code
# STT_MODEL=openai/whisper-1
# LLM_MODEL=google/gemini-3.1-flash-lite
# TTS_MODEL=google/gemini-3.1-flash-tts-preview
# TTS_VOICE=Kore
